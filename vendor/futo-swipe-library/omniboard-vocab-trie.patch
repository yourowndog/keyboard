+// --- Vocabulary tries -------------------------------------------------------
+//
+// SwipeEngine takes vocabularies as ITrie* pointers (Mode::dictionaries), which FUTO's own
+// keyboard fills in from its AOSP dictionary code. The library already ships a working trie
+// of its own (swipe_decoder::Trie, built by load_trie_simple), but no JNI entry point
+// constructs one -- so a caller holding only the AAR has no way to hand the engine a
+// vocabulary, and recognition returns nothing. These three functions expose the trie that is
+// already here; they add no decoding logic.
+//
+// Ownership: nativeLoad returns an owning Trie* handle. nativeItrie derives the borrowed
+// ITrie* that setMode() consumes, valid only while that handle is alive. Trie::itrie()
+// re-binds its userdata pointer on every call, so deriving it after the move below is safe.
+
+JNIEXPORT jlong JNICALL
+Java_org_futo_ml_inference_VocabTrie_nativeLoad(
+    JNIEnv* env, jclass /* clazz */, jstring vocabPath
+) {
+    const std::string path = jstr_or_empty(env, vocabPath);
+    if (path.empty()) {
+        LOGE("VocabTrie.nativeLoad: empty vocab path");
+        return 0;
+    }
+    auto loaded = load_trie_simple(path);
+    if (!loaded) {
+        LOGE("VocabTrie.nativeLoad: could not read vocab at %s", path.c_str());
+        return 0;
+    }
+    auto* trie = new Trie(std::move(*loaded));
+    LOGI("VocabTrie.nativeLoad: %zu words from %s", trie->size(), path.c_str());
+    return static_cast<jlong>(reinterpret_cast<uintptr_t>(trie));
+}
+
+JNIEXPORT jlong JNICALL
+Java_org_futo_ml_inference_VocabTrie_nativeItrie(
+    JNIEnv* /* env */, jclass /* clazz */, jlong handle
+) {
+    auto* trie = reinterpret_cast<Trie*>(static_cast<uintptr_t>(handle));
+    if (!trie) return 0;
+    return static_cast<jlong>(reinterpret_cast<uintptr_t>(trie->itrie()));
+}
+
+JNIEXPORT void JNICALL
+Java_org_futo_ml_inference_VocabTrie_nativeDestroy(
+    JNIEnv* /* env */, jclass /* clazz */, jlong handle
+) {
+    delete reinterpret_cast<Trie*>(static_cast<uintptr_t>(handle));
+}
+
 }  // extern "C"
