+package org.futo.ml.inference
+
+import java.io.Closeable
+
+/**
+ * A vocabulary the swipe engine can search.
+ *
+ * [SwipeDecoder.setMode] accepts vocabularies as raw native `ITrie` pointers, because FUTO's own
+ * keyboard supplies them from its AOSP dictionary code. This class wraps the trie implementation
+ * the library already ships, so a caller holding nothing but the AAR can load a word list from a
+ * file instead of having to implement `ITrie` natively.
+ *
+ * The file is an AOSP-style `.combined` word list: one entry per line, `word=<surface>,f=<freq>`.
+ * Leading whitespace is allowed and any line without a `word=` prefix is silently skipped, so
+ * ordinary header lines are harmless. Higher `f` means more common.
+ *
+ * [itriePtr] is a *borrowed* pointer into this object. Keep the trie open for as long as the
+ * decoder is using it, and [close] it only after the decoder has been closed or switched off it.
+ */
+class VocabTrie(vocabPath: String) : Closeable {
+    private var handle: Long = nativeLoad(vocabPath)
+
+    init {
+        check(handle != 0L) { "VocabTrie: failed to load vocabulary from $vocabPath" }
+    }
+
+    /** Native `ITrie*` to pass to [SwipeDecoder.setMode]. Must not outlive this object. */
+    val itriePtr: Long
+        get() {
+            check(handle != 0L) { "VocabTrie has been closed" }
+            return nativeItrie(handle)
+        }
+
+    override fun close() {
+        if (handle != 0L) {
+            nativeDestroy(handle)
+            handle = 0L
+        }
+    }
+
+    private companion object {
+        init {
+            System.loadLibrary("swipe_jni")
+        }
+
+        @JvmStatic external fun nativeLoad(vocabPath: String): Long
+        @JvmStatic external fun nativeItrie(handle: Long): Long
+        @JvmStatic external fun nativeDestroy(handle: Long)
+    }
+}
