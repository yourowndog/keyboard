{
  "$schema": "https://schemas.florisboard.org/snygg/v2/stylesheet",
  "@defines": {
    "--void-prime": "#050505",
    "--void-deep": "#000000",
    "--void-panel": "#0D1117",
    "--void-glass": "#050505EE",
    "--hull-100": "#C7CCD8",
    "--hull-300": "#8FA3B8",
    "--hull-500": "#5F7186",
    "--hull-700": "#2C353F",
    "--hull-900": "#161B22",
    "--coral-neon": "#FF3D00",
    "--coral-deep": "#F4511E",
    "--coral-dim": "#BF360C",
    "--coral-text": "#FFAB91",
    "--coral-glass": "#F4511E40",
    "--cyan-neon": "#00FFFF",
    "--cyan-bright": "#00E5FF",
    "--cyan-dim": "#00838F",
    "--cyan-glass": "#00E5FF33",
    "--gold-prime": "#FFC107",
    "--gold-dim": "#FF8F00",
    "--red-alert": "#D50000",
    "--red-dim": "#B71C1C",
    "--text-primary": "#C7CCD8",
    "--text-inverse": "#050505",
    "--transparent": "#00000000"
  },
  "window": {
    "background": "var(--void-deep)",
    "clip": "no"
  },
  "keyboard": {
    "background": "var(--void-deep)"
  },
  "key": {
    "background": "var(--hull-900)",
    "foreground": "var(--text-primary)",
    "font-size": "18sp",
    "shadow-elevation": "0dp",
    "border-width": "1dp",
    "border-color": "var(--hull-700)",
    "shape": "cut-corner(6dp, 6dp, 6dp, 6dp)"
  },
  "key:pressed": {
    "background": "var(--cyan-bright)",
    "foreground": "var(--text-inverse)",
    "shadow-elevation": "12dp",
    "shadow-color": "var(--cyan-neon)",
    "border-color": "var(--cyan-neon)"
  },
  "key[code=97..122,65..90,32,44,46,47]": {
    "background": "var(--hull-700)",
    "foreground": "var(--cyan-bright)",
    "font-weight": "bold",
    "shape": "rounded-corner(8dp, 8dp, 8dp, 8dp)",
    "border-color": "var(--hull-500)"
  },
  "key[code=32]": {
    "font-size": "12sp",
    "text-overflow": "ellipsis"
  },
  "key[code=-15,10,-1]": {
    "background": "var(--coral-dim)",
    "foreground": "var(--coral-text)",
    "border-color": "var(--coral-deep)",
    "shape": "cut-corner(12dp, 12dp, 12dp, 12dp)"
  },
  "key[code=-28..-21]": {
    "background": "var(--gold-dim)",
    "foreground": "var(--text-inverse)",
    "border-color": "var(--gold-prime)",
    "shape": "rounded-corner(4dp, 4dp, 4dp, 4dp)"
  },
  "key[code=-206..-201,-35,-31,-33,34,45,95]": {
    "background": "var(--hull-900)",
    "foreground": "var(--hull-300)",
    "border-color": "var(--hull-500)",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "key[code=-14,-11,-7,-4,-131]": {
    "background": "var(--cyan-dim)",
    "foreground": "var(--cyan-bright)",
    "border-color": "var(--cyan-bright)",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "key-popup-box": {
    "background": "var(--void-panel)",
    "foreground": "var(--cyan-bright)",
    "shadow-elevation": "4dp",
    "shadow-color": "var(--cyan-glass)",
    "border-width": "1dp",
    "border-color": "var(--cyan-dim)",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "key-popup-element": {
    "background": "transparent",
    "foreground": "var(--text-primary)"
  },
  "key-popup-element:focus": {
    "background": "var(--cyan-dim)",
    "foreground": "var(--cyan-bright)"
  },
  "smartbar": {
    "background": "transparent"
  },
  "smartbar-candidate-word": {
    "background": "transparent",
    "foreground": "var(--cyan-bright)",
    "font-size": "18sp",
    "font-weight": "bold"
  },
  "smartbar-candidate-spacer": {
    "background": "var(--hull-700)"
  },
  "smartbar-action-key": {
    "background": "transparent",
    "foreground": "var(--hull-300)",
    "shape": "circle()"
  },
  "smartbar-action-tile": {
    "background": "var(--void-glass)",
    "foreground": "var(--hull-100)",
    "border-width": "1dp",
    "border-color": "var(--hull-500)",
    "shape": "cut-corner(4dp, 4dp, 4dp, 4dp)"
  },
  "smartbar-shared-actions-toggle": {
    "background": "transparent",
    "foreground": "var(--coral-text)"
  },
  "smartbar-extended-actions-toggle": {
    "background": "transparent",
    "foreground": "var(--coral-text)"
  },
  "clipboard-header": {
    "foreground": "var(--cyan-bright)",
    "font-weight": "bold"
  },
  "clipboard-content": {
    "background": "var(--void-glass)"
  },
  "clipboard-item": {
    "background": "var(--void-panel)",
    "foreground": "var(--text-primary)",
    "border-width": "1dp",
    "border-color": "var(--hull-700)",
    "shape": "cut-corner(4dp, 4dp, 4dp, 4dp)"
  },
  "clipboard-item:pressed": {
    "background": "var(--cyan-dim)",
    "foreground": "var(--cyan-bright)"
  },
  "clipboard-item-popup": {
    "background": "var(--void-panel)",
    "foreground": "var(--cyan-bright)",
    "border-color": "var(--cyan-dim)",
    "border-width": "1dp",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  }
}