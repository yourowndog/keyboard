{
  "$schema": "https://schemas.florisboard.org/snygg/v2/stylesheet",
  "@defines": {
    "--void-prime": "#050505",
    "--void-deep": "#000000",
    "--void-panel": "#0D1117",
    "--void-glass": "#050505EE",
    "--hull-100": "#C7CCD8",
    "--hull-300": "#8FA3B8",
    "--hull-500": "#5F7186",
    "--hull-700": "#2C353F",
    "--hull-900": "#161B22",
    "--coral-neon": "#FF3D00",
    "--coral-deep": "#F4511E",
    "--coral-dim": "#BF360C",
    "--coral-text": "#FFAB91",
    "--coral-glass": "#F4511E40",
    "--cyan-neon": "#00FFFF",
    "--cyan-bright": "#00E5FF",
    "--cyan-dim": "#00838F",
    "--cyan-glass": "#00E5FF33",
    "--gold-prime": "#FFC107",
    "--gold-dim": "#FF8F00",
    "--red-alert": "#D50000",
    "--red-dim": "#B71C1C",
    "--text-primary": "#C7CCD8",
    "--text-inverse": "#050505",
    "--transparent": "#00000000"
  },
  "window": {
    "background": "var(--void-deep)",
    "clip": "no"
  },
  "keyboard": {
    "background": "var(--void-deep)"
  },
  "key": {
    "background": "var(--hull-900)",
    "foreground": "var(--text-primary)",
    "font-size": "18sp",
    "shadow-elevation": "0dp",
    "border-width": "1dp",
    "border-color": "var(--hull-700)",
    "shape": "cut-corner(6dp, 6dp, 6dp, 6dp)"
  },
  "key:pressed": {
    "background": "var(--cyan-bright)",
    "foreground": "var(--text-inverse)",
    "shadow-elevation": "12dp",
    "shadow-color": "var(--cyan-neon)",
    "border-color": "var(--cyan-neon)"
  },
  "key[code=97..122,65..90,32,44,46]": {
    "background": "var(--hull-700)",
    "foreground": "var(--cyan-bright)",
    "font-weight": "bold",
    "shape": "rounded-corner(8dp, 8dp, 8dp, 8dp)",
    "border-color": "var(--hull-500)"
  },
  "key[code=32]": {
    "font-size": "12sp",
    "text-overflow": "ellipsis"
  },
  "key[code=-15,10,-1]": {
    "background": "var(--coral-dim)",
    "foreground": "var(--coral-text)",
    "border-color": "var(--coral-deep)",
    "shape": "cut-corner(12dp, 12dp, 12dp, 12dp)"
  },
  "key[code=-28..-21]": {
    "background": "var(--gold-dim)",
    "foreground": "var(--text-inverse)",
    "border-color": "var(--gold-prime)",
    "shape": "rounded-corner(4dp, 4dp, 4dp, 4dp)"
  },
  "key[code=-206..-201,-35,-31,-33,34,37,45,47,58,95]": {
    "background": "var(--hull-900)",
    "foreground": "var(--hull-300)",
    "border-color": "var(--hull-500)",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "key[code=-14,-11,-7,-4,-131]": {
    "background": "var(--cyan-dim)",
    "foreground": "var(--cyan-bright)",
    "border-color": "var(--cyan-bright)",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "key[code=-305,-306]": {
    "background": "var(--hull-700)",
    "foreground": "var(--cyan-dim)",
    "border-color": "var(--cyan-dim)",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "key[code=-1]:focus": {
    "background": "var(--cyan-bright)",
    "foreground": "var(--text-inverse)",
    "border-color": "var(--cyan-neon)"
  },
  "key[code=-1]:hover": {
    "background": "var(--cyan-bright)",
    "foreground": "var(--text-inverse)",
    "border-color": "var(--cyan-neon)",
    "shadow-elevation": "12dp",
    "shadow-color": "var(--cyan-neon)"
  },
  "key[code=-305,-306]:focus": {
    "background": "var(--cyan-bright)",
    "foreground": "var(--text-inverse)",
    "border-color": "var(--cyan-neon)"
  },
  "key-popup-box": {
    "background": "var(--void-panel)",
    "foreground": "var(--cyan-bright)",
    "shadow-elevation": "4dp",
    "shadow-color": "var(--cyan-glass)",
    "border-width": "1dp",
    "border-color": "var(--cyan-dim)",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "key-popup-element": {
    "background": "transparent",
    "foreground": "var(--text-primary)"
  },
  "key-popup-element:focus": {
    "background": "var(--cyan-dim)",
    "foreground": "var(--cyan-bright)"
  },
  "smartbar": {
    "background": "transparent"
  },
  "smartbar-candidate-word": {
    "background": "transparent",
    "foreground": "var(--cyan-bright)",
    "font-size": "18sp",
    "font-weight": "bold"
  },
  "smartbar-candidate-spacer": {
    "background": "var(--hull-700)"
  },
  "smartbar-action-key": {
    "background": "transparent",
    "foreground": "var(--hull-300)",
    "shape": "circle()"
  },
  "smartbar-action-tile": {
    "background": "var(--void-glass)",
    "foreground": "var(--hull-100)",
    "border-width": "1dp",
    "border-color": "var(--hull-500)",
    "shape": "cut-corner(4dp, 4dp, 4dp, 4dp)"
  },
  "smartbar-shared-actions-toggle": {
    "background": "transparent",
    "foreground": "var(--coral-text)"
  },
  "smartbar-extended-actions-toggle": {
    "background": "transparent",
    "foreground": "var(--coral-text)"
  },
  "clipboard-header": {
    "foreground": "var(--cyan-bright)",
    "font-weight": "bold"
  },
  "clipboard-content": {
    "background": "var(--void-glass)"
  },
  "clipboard-item": {
    "background": "var(--void-panel)",
    "foreground": "var(--text-primary)",
    "border-width": "1dp",
    "border-color": "var(--hull-700)",
    "shape": "cut-corner(4dp, 4dp, 4dp, 4dp)"
  },
  "clipboard-item:pressed": {
    "background": "var(--cyan-dim)",
    "foreground": "var(--cyan-bright)"
  },
  "smartbar-candidate-word:pressed": {
    "background": "var(--hull-700)",
    "foreground": "var(--cyan-bright)"
  },
  "smartbar-candidate-clip": {
    "background": "transparent",
    "foreground": "var(--cyan-bright)",
    "font-size": "14sp",
    "margin": "4dp",
    "padding": "8dp 0dp",
    "shape": "cut-corner(4dp, 4dp, 4dp, 4dp)",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-candidate-clip:pressed": {
    "background": "var(--hull-700)",
    "foreground": "var(--cyan-bright)"
  },
  "smartbar-candidate-clip-icon": {
    "margin": "0dp 0dp(4dp) 0dp"
  },
  "smartbar-candidate-spacer": {
    "foreground": "rgba(0, 255, 255, 0.25)"
  },
  "smartbar-action-key:disabled": {
    "foreground": "var(--hull-700)"
  },
  "smartbar-action-tile-icon": {
    "font-size": "24sp",
    "margin": "0dp 0dp 0dp 8dp"
  },
  "smartbar-actions-editor": {
    "background": "var(--void-panel)",
    "foreground": "var(--text-primary)",
    "shape": "cut-corner(12dp, 12dp, 0dp, 0dp)"
  },
  "smartbar-actions-editor-header": {
    "background": "var(--hull-900)",
    "foreground": "var(--cyan-bright)",
    "font-size": "16sp",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-header-button": {
    "margin": "4dp",
    "shape": "circle()"
  },
  "smartbar-actions-editor-subheader": {
    "foreground": "var(--coral-neon)",
    "font-size": "16sp",
    "font-weight": "bold",
    "padding": "12dp 16dp 12dp 8dp",
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "smartbar-actions-editor-tile-grid": {
    "margin": "4dp 0dp"
  },
  "smartbar-actions-editor-tile": {
    "margin": "4dp",
    "padding": "8dp",
    "text-align": "center",
    "text-max-lines": "2",
    "text-overflow": "ellipsis"
  },
  "clipboard-header-button": {
    "margin": "4dp",
    "shape": "circle()"
  },
  "clipboard-header-button:disabled": {
    "foreground": "var(--hull-700)"
  },
  "clipboard-header-text": {
    "text-max-lines": "1",
    "text-overflow": "ellipsis"
  },
  "clipboard-subheader": {
    "foreground": "var(--gold-prime)",
    "font-size": "14sp",
    "margin": "6dp 10dp 6dp 6dp"
  },
  "clipboard-filter-row": {
    "background": "var(--void-deep)",
    "foreground": "var(--text-primary)",
    "padding": "0dp 0dp 4dp 0dp"
  },
  "clipboard-filter-chip": {
    "background": "var(--hull-900)",
    "foreground": "var(--hull-300)",
    "margin": "4dp 4dp 0dp 4dp",
    "padding": "8dp 4dp",
    "shape": "cut-corner(4dp, 4dp, 4dp, 4dp)"
  },
  "clipboard-filter-chip[state=`active`]": {
    "background": "var(--coral-neon)",
    "foreground": "var(--text-inverse)"
  },
  "clipboard-filter-chip-text": {
    "margin": "4dp 0dp 0dp 0dp"
  },
  "clipboard-item-description": {
    "font-size": "12sp",
    "font-style": "italic",
    "foreground": "var(--hull-300)"
  },
  "clipboard-item-action": {
    "font-size": "16sp",
    "padding": "12dp",
    "foreground": "var(--cyan-bright)"
  },
  "media-emoji-subheader": {
    "foreground": "var(--gold-prime)",
    "font-weight": "bold",
    "margin": "4dp"
  },
  "media-emoji-key": {
    "background": "transparent",
    "foreground": "var(--text-primary)",
    "font-size": "22sp",
    "shape": "rounded-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "media-emoji-key:pressed": {
    "background": "var(--hull-700)",
    "foreground": "var(--cyan-bright)"
  },
  "media-emoji-tab": {
    "foreground": "var(--hull-300)"
  },
  "media-emoji-tab:focus": {
    "foreground": "var(--cyan-bright)"
  },
  "media-bottom-row-button": {
    "background": "var(--hull-900)",
    "foreground": "var(--cyan-bright)",
    "padding": "16dp 0dp",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  },
  "clipboard-item-popup": {
    "background": "var(--void-panel)",
    "foreground": "var(--cyan-bright)",
    "border-color": "var(--cyan-dim)",
    "border-width": "1dp",
    "shape": "cut-corner(8dp, 8dp, 8dp, 8dp)"
  }
}
