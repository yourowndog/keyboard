        "padding": "16dp"
    },
    "clipboard-clear-all-dialog-buttons": {
        "padding": "4dp"
    },
    "clipboard-clear-all-dialog-button": {
        "background": "transparent",
        "foreground": "var(--neon-red)",
        "shape": "var(--shape-key)"
    },
