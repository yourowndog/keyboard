{
  "$": "ime.extension.keyboard",
  "meta": {
    "id": "org.florisboard.localization",
    "version": "0.2.3",
    "title": "Default subtype presets / popup mappings",
    "description": "Trimmed to English presets and popup mappings only.",
    "maintainers": [
      "patrickgold <patrick@patrickgold.dev>"
    ],
    "license": "apache-2.0"
  },
  "dependencies": [
    "org.florisboard.composers",
    "org.florisboard.currencysets",
    "org.florisboard.layouts"
  ],
  "punctuationRules": [
    {
      "id": "default",
      "label": "Default",
      "symbolsPrecedingAutoSpace": ".,?\u203d!&%)]}\u00bb",
      "symbolsFollowingAutoSpace": "",
      "symbolsPrecedingPhantomSpace": ".,;:?\u203d!&%)]}\u00bb\u00a9\u00ae\u2122",
      "symbolsFollowingPhantomSpace": "\u00bf\u2e18\u00a1([{",
      "symbolsTerminatingSentence": ".?\u203d!"
    }
  ],
  "popupMappings": [
    {
      "id": "default",
      "authors": [
        "patrickgold"
      ]
    },
    {
      "id": "en",
      "authors": [
        "patrickgold"
      ]
    },
    {
      "id": "en_wide",
      "label": "English Wide (Coder)",
      "authors": [
        "Sam/Codex"
      ]
    }
  ],
  "subtypePresets": [
    {
      "languageTag": "en-US",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:dollar",
      "popupMapping": "org.florisboard.localization:en",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty"
      }
    },
    {
      "languageTag": "en-UK",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:pound",
      "popupMapping": "org.florisboard.localization:en",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty"
      }
    },
    {
      "languageTag": "en-CA",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:dollar",
      "popupMapping": "org.florisboard.localization:en",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty"
      }
    },
    {
      "languageTag": "en-AU",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:dollar",
      "popupMapping": "org.florisboard.localization:en",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty"
      }
    },
    {
      "languageTag": "en-US",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:dollar",
      "popupMapping": "org.florisboard.localization:en_wide",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty_wide",
        "symbols": "org.florisboard.layouts:western_wide"
      }
    },
    {
      "languageTag": "en-UK",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:pound",
      "popupMapping": "org.florisboard.localization:en_wide",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty_wide",
        "symbols": "org.florisboard.layouts:western_wide"
      }
    },
    {
      "languageTag": "en-CA",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:dollar",
      "popupMapping": "org.florisboard.localization:en_wide",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty_wide",
        "symbols": "org.florisboard.layouts:western_wide"
      }
    },
    {
      "languageTag": "en-AU",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:dollar",
      "popupMapping": "org.florisboard.localization:en_wide",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty_wide",
        "symbols": "org.florisboard.layouts:western_wide"
      }
    }
  ]
}
