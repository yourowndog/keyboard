[Unit]
Description=Build the OmniBoard keylog training dataset from the raw archive
After=keylog-archive.service

[Service]
Type=oneshot
User=sam
Group=sam
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 /opt/keylog-archive/build_dataset.py
Environment=KEYLOG_ARCHIVE_ROOT=/home/sam/datasets/sam-keylog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sam/datasets/sam-keylog/derived
